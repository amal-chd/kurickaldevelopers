rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // Helper functions
    // ─────────────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data : null;
    }

    function getUserRole() {
      let uData = getUserData();
      let rolePath = /databases/$(database)/documents/roles/$(uData != null ? uData.roleId : '_none_');
      return uData != null && exists(rolePath) ? get(rolePath).data : null;
    }

    function hasPermission(permKey) {
      let role = getUserRole();
      return isAuthenticated() && role != null && role.permissions.get(permKey, false) == true;
    }

    function myLevel() {
      let role = getUserRole();
      return role != null ? role.get('level', 0) : 0;
    }

    function isProjectMember(projectId) {
      let projPath = /databases/$(database)/documents/projects/$(projectId);
      return isAuthenticated() &&
             exists(projPath) &&
             request.auth.uid in get(projPath).data.memberIds;
    }

    function isProjectManager(projectId) {
      let projPath = /databases/$(database)/documents/projects/$(projectId);
      // Unified schema stores the manager as projectManagerId; fall back to
      // the legacy managerId field for documents created before the rename.
      return isAuthenticated() &&
             exists(projPath) &&
             request.auth.uid == get(projPath).data.get('projectManagerId',
               get(projPath).data.get('managerId', ''));
    }

    // ── Self role-assignment guard (prevents privilege escalation) ──
    // A user may only ever give THEMSELVES the role bootstrapped for their
    // authenticated email (mirrors the client EMAIL_ROLE_MAP) — never an
    // arbitrary/elevated role. Everyone else is created role-less and must be
    // assigned a role by a team_manage admin (which enforces the level cap).
    function bootstrapRoleFor(email) {
      return email == 'thomas@kurickaldevelopers.com' ? 'director'
           : email == 'meena@kurickaldevelopers.com'  ? 'admin'
           : email == 'ravi@kurickaldevelopers.com'   ? 'project_manager'
           : email == 'arjun@kurickaldevelopers.com'  ? 'site_engineer'
           : email == 'priya@kurickaldevelopers.com'  ? 'site_engineer'
           : email == 'suresh@kurickaldevelopers.com' ? 'foreman'
           : email == 'biju@kurickaldevelopers.com'   ? 'labour'
           : email == 'anitha@kurickaldevelopers.com' ? 'accounts'
           : '';
    }
    function roleAllowedForSelf(roleId) {
      return roleId == null || roleId == '' ||
             roleId == bootstrapRoleFor(request.auth.token.email);
    }

    // ── Task read authorization (shared by tasks + their subcollections) ──
    // Same policy as the tasks read rule: assignees (direct or via role),
    // creator, or a tasks_view_all holder. Used to stop subcollections
    // (comments/subtasks) from leaking task data the parent rule hides.
    function canReadTask(taskId) {
      let tPath = /databases/$(database)/documents/tasks/$(taskId);
      return isAuthenticated() && exists(tPath) &&
        (
          request.auth.uid in get(tPath).data.assigneeIds ||
          request.auth.uid == get(tPath).data.createdBy ||
          hasPermission('tasks_view_all') ||
          (get(tPath).data.get('assignedRoleId', null) != null &&
           getUserData() != null &&
           get(tPath).data.get('assignedRoleId', null) == getUserData().roleId) ||
          (get(tPath).data.get('assignedRoleIds', null) != null &&
           getUserData() != null &&
           getUserData().roleId in get(tPath).data.get('assignedRoleIds', []))
        );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Users
    // ─────────────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isAuthenticated();

      // A new user can create their own profile on sign-up — but may only
      // self-assign the role bootstrapped for their email (usually none).
      // Prevents anyone (e.g. any Google account) from creating their user
      // doc with roleId:'director' and escalating to full control.
      allow create: if isOwner(userId) &&
                    roleAllowedForSelf(request.resource.data.get('roleId', null));

      // Self-update: may change name/phone/avatar/fcmToken. May NOT change
      // isActive, and may only set roleId to their bootstrap role (never an
      // arbitrary/elevated one — closes the "role-less user promotes self"
      // escalation the old rule allowed).
      // team_manage: may update any field for any user EXCEPT escalating roleId above their own level
      allow update: if isAuthenticated() && (
        // Owner updating their own non-sensitive fields
        (isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roleId']) ||
            roleAllowedForSelf(request.resource.data.get('roleId', null))
          )
        ) ||
        // team_manage updating other users (role change constrained)
        (hasPermission('team_manage') && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roleId']) ||
          request.resource.data.roleId == null || 
          request.resource.data.roleId == '' ||
          (
            exists(/databases/$(database)/documents/roles/$(request.resource.data.roleId)) &&
            get(/databases/$(database)/documents/roles/$(request.resource.data.roleId)).data.get('level', 0) <= myLevel()
          )
        ))
      );

      // team_manage can deactivate users (isActive change)
      // This is handled via the update rule above (they can change isActive)

      // Only allow delete with team_delete permission
      allow delete: if hasPermission('team_delete');

      // Private subcollection
      match /private/{docId} {
        allow read:  if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Roles
    // ─────────────────────────────────────────────────────────────────────────

    match /roles/{roleId} {
      allow read: if isAuthenticated();
      
      // Allow Director to manage roles, or ANY user who has roleId == 'director' (to solve the chicken-and-egg problem on first boot)
      allow create: if (hasPermission('roles_manage') &&
                    request.resource.data.get('level', 0) <= myLevel()) || 
                    (getUserData() != null && getUserData().roleId == 'director');
                    
      allow update: if (hasPermission('roles_manage') &&
                    request.resource.data.get('level', 0) <= myLevel() &&
                    resource.data.get('level', 0) <= myLevel()) ||
                    (getUserData() != null && getUserData().roleId == 'director');
                    
      allow delete: if ((hasPermission('roles_manage') && resource.data.get('level', 0) <= myLevel()) ||
                    (getUserData() != null && getUserData().roleId == 'director')) &&
                    resource.data.get('isSystem', false) == false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Projects
    // ─────────────────────────────────────────────────────────────────────────

    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid == resource.data.get('projectManagerId',
          resource.data.get('managerId', '')) ||
        hasPermission('projects_view_all')
      );
      allow create: if hasPermission('projects_create');
      allow update: if hasPermission('projects_edit') || isProjectManager(projectId);
      allow delete: if hasPermission('projects_delete');

      // Milestones subcollection
      match /milestones/{milestoneId} {
        allow read: if isAuthenticated() && (
          isProjectMember(projectId) ||
          isProjectManager(projectId) ||
          hasPermission('projects_view_all')
        );
        allow write: if hasPermission('projects_edit') || isProjectManager(projectId);
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Tasks
    // ─────────────────────────────────────────────────────────────────────────

    match /tasks/{taskId} {
      // Task visibility policy: ONLY the assignees (direct or via role), the
      // creator, and roles with tasks_view_all (Director / PM / Admin) may
      // read a task. Project membership alone does NOT grant task access.
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.assigneeIds ||
        request.auth.uid == resource.data.createdBy ||
        hasPermission('tasks_view_all') ||
        (resource.data.get('assignedRoleId', null) != null &&
         getUserData() != null &&
         resource.data.get('assignedRoleId', null) == getUserData().roleId) ||
        (resource.data.get('assignedRoleIds', null) != null &&
         getUserData() != null &&
         getUserData().roleId in resource.data.get('assignedRoleIds', []))
      );
      allow create: if hasPermission('tasks_create');
      allow update: if hasPermission('tasks_edit') ||
        request.auth.uid in resource.data.assigneeIds ||
        (resource.data.get('assignedRoleId', null) != null &&
         getUserData() != null &&
         resource.data.get('assignedRoleId', null) == getUserData().roleId) ||
        (resource.data.get('assignedRoleIds', null) != null &&
         getUserData() != null &&
         getUserData().roleId in resource.data.get('assignedRoleIds', []));
      allow delete: if hasPermission('tasks_delete');

      // Subtasks — only users who can see the parent task (matches the task
      // read policy; previously any authenticated user could read them).
      match /subtasks/{subtaskId} {
        allow read: if canReadTask(taskId);
        allow write: if hasPermission('tasks_edit') ||
          (exists(/databases/$(database)/documents/tasks/$(taskId)) &&
           request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.assigneeIds);
      }

      // Comments — only users who can see the parent task may read/post
      // (previously any authenticated user could, leaking task discussion).
      match /comments/{commentId} {
        allow read: if canReadTask(taskId);
        allow create: if canReadTask(taskId);
        allow update: if isAuthenticated() && request.auth.uid == resource.data.authorId;
        allow delete: if hasPermission('tasks_delete') ||
          request.auth.uid == resource.data.authorId;
      }

      // Time logs
      match /timeLogs/{logId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == resource.data.userId ||
          hasPermission('time_view_all')
        );
        allow create: if hasPermission('time_log');
        allow update: if request.auth.uid == resource.data.userId;
        allow delete: if false;
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Documents
    // ─────────────────────────────────────────────────────────────────────────

    match /documents/{docId} {
      allow read: if isAuthenticated() && (
        hasPermission('docs_view_all') ||
        request.auth.uid == resource.data.uploadedBy ||
        (resource.data.projectId != null &&
          exists(/databases/$(database)/documents/projects/$(resource.data.projectId)) &&
          request.auth.uid in get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.memberIds)
      );
      allow create: if hasPermission('docs_upload');
      allow update: if hasPermission('docs_upload') || hasPermission('docs_approve');
      allow delete: if (hasPermission('docs_upload') && request.auth.uid == resource.data.uploadedBy) ||
                       hasPermission('docs_approve') || 
                       myLevel() >= 90;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Attendance
    // ─────────────────────────────────────────────────────────────────────────

    match /attendance/{attendanceId} {
      // Read: own records, project members of the same project, or team_manage.
      // Project members can see who else is on site (Team → "Today On Site").
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        hasPermission('team_manage') ||
        hasPermission('attendance_view_all') ||
        (resource.data.projectId != null &&
          exists(/databases/$(database)/documents/projects/$(resource.data.projectId)) &&
          request.auth.uid in get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.memberIds)
      );
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Notifications (push / in-app)
    // ─────────────────────────────────────────────────────────────────────────

    match /notifications/{notifId} {
      // userId == '' means broadcast; userId == uid means targeted
      allow read: if isAuthenticated() && (
        resource.data.userId == '' ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated();
      // Targeted notif: the recipient may update it freely (e.g. mark read).
      // Broadcast (userId == ''): any user may ONLY touch the isRead map to
      // mark it read for themselves — not edit its title/body. Previously any
      // user could rewrite or delete a company-wide broadcast.
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.userId == '' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']))
      );
      // Targeted notif: recipient may delete their own. Broadcast: only a
      // notifications_manage admin may delete it.
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.userId == '' && hasPermission('notifications_manage'))
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Site Diary
    // ─────────────────────────────────────────────────────────────────────────

    match /site_diaries/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.authorId ||
        hasPermission('projects_edit')
      );
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Chat Channels
    // ─────────────────────────────────────────────────────────────────────────

    match /chats/{channelId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.memberIds ||
        hasPermission('chat_view')
      );
      allow create: if isAuthenticated() && (
        hasPermission('chat_create_group') ||
        hasPermission('chat_announce') ||
        // DM channels — any authenticated user can start a DM
        (request.resource.data.type == 'direct' &&
          request.auth.uid in request.resource.data.memberIds) ||
        // Project channels created automatically
        request.resource.data.type == 'project'
      );
      // Members can update unread counts; admins can update everything
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.memberIds ||
        hasPermission('chat_moderate')
      );
      allow delete: if hasPermission('chat_moderate');

      // Messages
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          exists(/databases/$(database)/documents/chats/$(channelId)) && (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(channelId)).data.memberIds ||
            hasPermission('chat_moderate') ||
            (get(/databases/$(database)/documents/chats/$(channelId)).data.type == 'announcement' && hasPermission('chat_view'))
          )
        );
        // Posting: must be a channel member; announcement channels additionally
        // require the chat_announce permission (previously UI-only, so any
        // member with chat_send could write into an announcement channel).
        allow create: if isAuthenticated() &&
          exists(/databases/$(database)/documents/chats/$(channelId)) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(channelId)).data.memberIds &&
          (
            (get(/databases/$(database)/documents/chats/$(channelId)).data.type == 'announcement' &&
              hasPermission('chat_announce')) ||
            (get(/databases/$(database)/documents/chats/$(channelId)).data.type in ['direct', 'project']) ||
            (get(/databases/$(database)/documents/chats/$(channelId)).data.type == 'group' &&
              hasPermission('chat_send'))
          );
        allow update: if isAuthenticated() && (
          request.auth.uid == resource.data.senderId ||
          hasPermission('chat_moderate')
        );
        allow delete: if isAuthenticated() && (
          request.auth.uid == resource.data.senderId ||
          hasPermission('chat_moderate')
        );
      }

      match /typing/{userId} {
        allow read: if isAuthenticated() && (
          exists(/databases/$(database)/documents/chats/$(channelId)) && (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(channelId)).data.memberIds ||
            hasPermission('chat_moderate') ||
            (get(/databases/$(database)/documents/chats/$(channelId)).data.type == 'announcement' && hasPermission('chat_view'))
          )
        );
        allow create, update, delete: if isAuthenticated() &&
          request.auth.uid == userId && (
            exists(/databases/$(database)/documents/chats/$(channelId)) &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(channelId)).data.memberIds
          );
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Performance Scores & Reviews
    // ─────────────────────────────────────────────────────────────────────────

    match /performance_scores/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        hasPermission('performance_view') ||
        hasPermission('team_manage')
      );
      // Only the user themselves or a manager/admin can update scores
      allow write: if isAuthenticated() && (
        isOwner(userId) || 
        hasPermission('tasks_approve') || 
        hasPermission('performance_manage')
      );
    }

    match /performance_reviews/{reviewId} {
      // Users can read reviews about themselves, managers can read all
      allow read: if isAuthenticated() && (
        resource.data.revieweeId == request.auth.uid || 
        hasPermission('performance_view') || 
        hasPermission('team_manage') || 
        resource.data.reviewerId == request.auth.uid
      );
      // Only managers can create reviews, or peers if we allow peer reviews, but reviewerId must match auth uid
      allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /settings/performance_config {
      allow read: if isAuthenticated();
      allow write: if hasPermission('performance_manage') || hasPermission('settings_manage');
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Admin: Org Settings
    // ─────────────────────────────────────────────────────────────────────────

    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('settings_manage');
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Admin: Audit Logs
    // ─────────────────────────────────────────────────────────────────────────

    match /audit_logs/{logId} {
      // Any admin with roles_manage can read; system writes come from clients with that permission
      allow read: if hasPermission('roles_manage') || hasPermission('settings_manage');
      allow create: if hasPermission('roles_manage') || hasPermission('team_manage') ||
                       hasPermission('settings_manage');
      allow update: if false;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Admin: Invitations
    // ─────────────────────────────────────────────────────────────────────────

    match /invitations/{invId} {
      allow read: if hasPermission('team_manage') || hasPermission('roles_manage');
      allow create: if hasPermission('team_manage') || hasPermission('roles_manage');
      allow update: if hasPermission('team_manage') || hasPermission('roles_manage');
      allow delete: if hasPermission('team_manage') || hasPermission('roles_manage');
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Admin: Broadcast Notifications
    // ─────────────────────────────────────────────────────────────────────────

    match /broadcast_notifications/{notifId} {
      allow read: if hasPermission('notifications_manage') || hasPermission('roles_manage');
      allow create: if hasPermission('notifications_manage');
      allow update: if false;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Contact Inquiries (website & mobile app)
    // ─────────────────────────────────────────────────────────────────────────

    match /contact_inquiries/{inquiryId} {
      // Anyone (including unauthenticated public) can submit — website visitors
      // and mobile app users don't need a TMS account to enquire.
      // Must validate basic fields to prevent abuse/spam.
      allow create: if 
        request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt', 'status']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100 &&
        request.resource.data.email is string && request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() < 2000;

      // Only staff with contact_view or contact_manage can read.
      allow read: if isAuthenticated() &&
                  (hasPermission('contact_view') || hasPermission('contact_manage'));

      // Only contact_manage can update (change status, add notes) or delete.
      allow update: if isAuthenticated() && hasPermission('contact_manage');
      allow delete: if isAuthenticated() && hasPermission('contact_manage');
    }

  }
}
