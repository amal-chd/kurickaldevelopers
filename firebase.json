          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "kurikal-tms-app",
          "configurations": {
            "android": "1:1081889029959:android:39958f0546e18dc1301662",
